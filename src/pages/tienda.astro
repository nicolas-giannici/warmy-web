---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { PRODUCTS, CATEGORIES, priceLabel } from '../data/products';
const feat = PRODUCTS[0];
const rest = PRODUCTS.slice(1);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.name, PRODUCTS.filter((p) => p.cat === c.name).length]));
---
<Base title="Tienda · Warmy" description="Amigurumis, mantas, tops y accesorios tejidos a mano por Fio.">
  <section class="shop-head wrap">
    <div class="shop-head__sky" aria-hidden="true"></div>
    <h1 class="display shop-head__title"><em>Tienda</em><sup>({PRODUCTS.length})</sup></h1>
    <div class="shop-head__aside">
      <p class="lead">Todo lo que hay en el taller hoy. Lo que dice “a pedido” se teje cuando lo encargás.</p>
      <img src="/draco/draco-sentado.webp" alt="Draco cuidando la tienda" width="720" height="711" class="shop-head__draco" />
    </div>
  </section>

  <div class="filters" data-filters>
    <div class="wrap filters__in">
      <div class="filters__chips" role="group" aria-label="Filtrar por categoría">
        <button class="chip" aria-pressed="true" data-filter="all">Todo · {PRODUCTS.length}</button>
        {CATEGORIES.filter((c) => counts[c.name] > 0).map((c) => (
          <button class="chip" aria-pressed="false" data-filter={c.name}>{c.name} · {counts[c.name]}</button>
        ))}
      </div>
      <label class="filters__sort">
        <span>Ordenar:</span>
        <select data-sort>
          <option value="fav">Más mimados</option>
          <option value="asc">Menor precio</option>
          <option value="desc">Mayor precio</option>
          <option value="az">A–Z</option>
        </select>
        <Icon name="chevron-down" size={16} />
      </label>
    </div>
  </div>

  <section class="wrap shop">
    <article class="shop-feat" data-reveal data-cat={feat.cat} data-price={feat.price} data-name={feat.name}>
      <a href={`/producto/${feat.slug}`} class="shop-feat__media" style={`--bg:${feat.bg}`}>
        <span class="tag">{feat.tag}</span>
        {feat.photo
          ? <img class="shop-feat__photo" src={feat.photo} alt={feat.name} width="480" height="640" transition:name={`img-${feat.slug}`} data-fly />
          : <img src={feat.img} alt={feat.name} width="216" height="326" transition:name={`img-${feat.slug}`} data-fly />}
        <span class="sticker shop-feat__st"><small>PIEZA</small><strong>única</strong></span>
        <span class="shop-feat__info">
          <span class="display">{feat.name}</span>
          <small>{feat.cat} · {feat.size} · {feat.hours} h de tejido</small>
        </span>
      </a>
      <button class="btn shop-feat__add" data-add={feat.slug} aria-label={`Sumar ${feat.name} a la bolsa`}>{priceLabel(feat)} <Icon name="plus" size={18} /></button>
    </article>

    <div class="shop__grid" data-grid>
      {rest.slice(0, 4).map((p, i) => <ProductCard p={p} i={i} eager={i < 2} />)}
      <article class="promo" data-reveal data-cat="Personalizados" data-price="0" data-name="zz">
        <p class="label"><b>✶</b> A medida</p>
        <h2 class="display"><em>¿No está lo<br />que buscás?</em></h2>
        <p>Contanos tu idea y Fio la teje: colores, tamaño y hasta el nombre bordado.</p>
        <img src="/ilus/aguja.svg" alt="" width="176" height="246" class="promo__hook" />
        <a href="/#a-medida" class="btn btn--light">Empezar mi pedido <Icon name="arrow-up-right" /></a>
      </article>
      {rest.slice(4).map((p, i) => <ProductCard p={p} i={i + 4} />)}
    </div>
    <p class="shop__empty" data-empty hidden>
      <img src="/draco/draco-asomado.webp" alt="" width="713" height="720" />
      <span class="hand">No hay piezas acá todavía… ¡pero Fio te la teje a medida!</span>
    </p>
  </section>
</Base>

<style>
  .shop-head { position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; padding-top: clamp(30px, 5vw, 70px); padding-bottom: 32px; }
  .shop-head__sky { position: absolute; right: -10%; top: -260px; width: 600px; aspect-ratio: 1; border-radius: 50%; background: var(--cielo); opacity: .55; z-index: -1; }
  .shop-head__title { font-size: clamp(96px, 18vw, 260px); letter-spacing: -.05em; line-height: .9; }
  .shop-head__title sup { font: 600 clamp(18px, 2vw, 30px) var(--f-body); color: var(--lilac-deep); vertical-align: top; margin-left: 8px; letter-spacing: 0; }
  .shop-head__aside { display: flex; align-items: flex-end; gap: 12px; max-width: 520px; }
  .shop-head__aside .lead { margin: 0 0 12px; }
  .shop-head__draco { width: clamp(90px, 11vw, 150px); height: auto; flex: none; animation: float 5s ease-in-out infinite; }

  .filters { position: sticky; top: 76px; z-index: 30; transition: top .5s var(--ease); background: rgb(255 248 241 / .9); backdrop-filter: blur(12px); border-block: 1px solid var(--line); }
  .filters__in { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 14px; }
  :global(body:has(.nav.is-hidden)) .filters { top: 0; }
  .filters__chips { min-width: 0; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; margin: -2px; mask-image: linear-gradient(90deg, #000 92%, transparent); }
  .filters__chips::-webkit-scrollbar { display: none; }
  .filters__sort { position: relative; display: flex; align-items: center; gap: 6px; flex: none; font-size: 15px; color: var(--cocoa); }
  .filters__sort select { appearance: none; border: 1.5px solid var(--line); border-radius: 999px; padding: 10px 36px 10px 16px; background: var(--white); font-weight: 700; color: var(--choco); cursor: pointer; }
  .filters__sort :global(svg) { position: absolute; right: 14px; pointer-events: none; }

  .shop { padding-block: 40px clamp(90px, 10vw, 140px); display: grid; gap: clamp(40px, 4.4vw, 64px); }
  .shop-feat { position: relative; }
  .shop-feat__media { position: relative; display: grid; place-items: center; height: clamp(420px, 44vw, 640px); border-radius: var(--r-card); background: var(--bg); overflow: hidden; }
  .shop-feat__media img { height: 70%; width: auto; transform: translateX(-12%); transition: transform .8s var(--ease); }
  .shop-feat__media:hover img { transform: translateX(-12%) scale(1.05) rotate(-2deg); }
  .shop-feat__media > .tag { position: absolute; left: 28px; top: 28px; }
  .shop-feat__media img.shop-feat__photo { position: absolute; right: 0; top: 0; width: 48%; height: 100%; object-fit: cover; transform: none; border-radius: 0 var(--r-card) var(--r-card) 0; }
  .shop-feat__media:hover img.shop-feat__photo { transform: none; filter: saturate(1.08); }
  .shop-feat__media:has(.shop-feat__photo) .shop-feat__st { right: auto; left: 34%; }
  .shop-feat__st { --d: 130px; position: absolute; right: 8%; top: 8%; transform: rotate(-10deg); }
  .shop-feat__info { position: absolute; left: clamp(20px, 3vw, 40px); bottom: clamp(20px, 3vw, 36px); display: grid; gap: 4px; }
  .shop-feat__info .display { font-style: italic; font-size: clamp(40px, 5vw, 72px); }
  .shop-feat__info small { font-size: 15px; font-weight: 600; color: var(--cocoa); }
  .shop-feat__add { position: absolute; right: clamp(20px, 3vw, 36px); bottom: clamp(20px, 3vw, 36px); z-index: 2; }

  .shop__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 3.6vw, 56px) clamp(16px, 1.8vw, 24px); }
  .promo { position: relative; overflow: hidden; border-radius: var(--r-card); background: var(--lilac-deep); color: var(--cream); padding: 32px; display: flex; flex-direction: column; gap: 14px; min-height: 480px; }
  .promo .label { color: rgb(255 248 241 / .7); }
  .promo h2 { font-size: clamp(36px, 3.2vw, 46px); line-height: 1; }
  .promo p { margin: 0; max-width: 18em; color: rgb(255 248 241 / .85); }
  .promo__hook { position: absolute; right: 8%; bottom: 18%; width: 34%; height: auto; transform: rotate(18deg); opacity: .9; }
  .promo .btn { margin-top: auto; align-self: flex-start; position: relative; }
  /* .card vive en ProductCard (otro scope): hace falta :global para que el filtro la oculte */
  .shop :global(.card.is-hidden), .promo.is-hidden, .shop-feat.is-hidden { display: none; }
  .shop__empty { display: grid; justify-items: center; gap: 8px; text-align: center; }
  .shop__empty img { width: 220px; height: auto; }
  .shop__empty .hand { font-size: 30px; }

  @media (max-width: 1000px) { .shop__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .filters { top: 68px; }
    .filters__in { gap: 10px; padding-block: 10px; }
    .filters__sort > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .filters__sort select { padding-left: 14px; }
    .shop-head__aside { max-width: none; }
    .shop-feat__media img { transform: translateY(-10%); height: 58%; }
    .shop-feat__media:hover img { transform: translateY(-10%); }
    .shop-feat__st { --d: 96px; }
    .shop-feat__media:has(.shop-feat__photo) { height: auto; aspect-ratio: 3 / 4; }
    .shop-feat__media img.shop-feat__photo { width: 100%; border-radius: 0; }
    .shop-feat__media:has(.shop-feat__photo) .shop-feat__st { left: auto; right: 6%; }
    .shop-feat__media:has(.shop-feat__photo) .shop-feat__info { left: 0; right: 0; bottom: 0; padding: 60px 20px 20px; background: linear-gradient(transparent, rgb(255 248 241 / .95) 45%); }
    .shop-feat__add { position: static; margin-top: 12px; width: 100%; }
  }
  @media (max-width: 560px) { .shop__grid { grid-template-columns: 1fr; } .promo { min-height: 420px; } }
</style>

<script>
  function init() {
    const root = document.querySelector('[data-filters]');
    if (!root) return;
    const grid = document.querySelector<HTMLElement>('[data-grid]')!;
    const all = () => Array.from(document.querySelectorAll<HTMLElement>('.shop [data-cat]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    let cat = new URLSearchParams(location.search).get('cat') || 'all';
    const apply = () => {
      root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.filter === cat)));
      let shown = 0;
      all().forEach((el) => {
        const ok = cat === 'all' || el.dataset.cat === cat || el.classList.contains('promo');
        el.classList.toggle('is-hidden', !ok);
        if (ok && !el.classList.contains('promo')) { shown++; el.classList.add('is-in'); }
      });
      empty.hidden = shown > 0;
    };
    root.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.filter!;
      const u = new URL(location.href);
      cat === 'all' ? u.searchParams.delete('cat') : u.searchParams.set('cat', cat);
      history.replaceState(history.state, '', u);
      const go = () => apply();
      (document as any).startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches ? (document as any).startViewTransition(go) : go();
    }));
    root.querySelector<HTMLSelectElement>('[data-sort]')!.addEventListener('change', (e) => {
      const v = (e.target as HTMLSelectElement).value;
      const cards = Array.from(grid.children) as HTMLElement[];
      const promo = cards.find((c) => c.classList.contains('promo'))!;
      const items = cards.filter((c) => c !== promo);
      const orig = (el: HTMLElement) => Number(el.style.getPropertyValue('--o') || 0);
      items.forEach((el, i) => { if (!el.style.getPropertyValue('--o')) el.style.setProperty('--o', String(i)); });
      items.sort((a, b) => v === 'asc' ? +a.dataset.price! - +b.dataset.price! : v === 'desc' ? +b.dataset.price! - +a.dataset.price!
        : v === 'az' ? a.dataset.name!.localeCompare(b.dataset.name!) : orig(a) - orig(b));
      const go = () => { items.forEach((el) => grid.appendChild(el)); grid.insertBefore(promo, grid.children[Math.min(4, items.length)] || null); };
      (document as any).startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches ? (document as any).startViewTransition(go) : go();
    });
    apply();
  }
  document.addEventListener('astro:page-load', init);
</script>
