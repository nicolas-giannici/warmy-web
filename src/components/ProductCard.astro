---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import { type Product, priceLabel } from '../data/products';
const photo = Astro.props.p.photo;
interface Props { p: Product; showTag?: boolean; i?: number; eager?: boolean }
const { p, showTag = true, i = 0, eager = false } = Astro.props;
---
<article class="card" data-reveal style={`--i:${i % 3}`} data-cat={p.cat} data-price={p.price} data-name={p.name}>
  <div class="card__media" style={`--bg:${p.bg}`}>
    {showTag && p.tag && <span class="tag">{p.tag}</span>}
    {photo
      ? <img class="card__photo" data-fly src={photo} alt={p.name} width="480" height="640" loading={eager ? 'eager' : 'lazy'} decoding="async"
          transition:name={`img-${p.slug}`} />
      : <img class="card__img" data-fly src={p.img} alt={p.name} width="216" height="326" loading={eager ? 'eager' : 'lazy'}
          transition:name={`img-${p.slug}`} />}
    <button class="card__fav" aria-label={`Guardar ${p.name} en favoritos`} aria-pressed="false"><Icon name="heart" /></button>
    <div class="card__quick">
      <span class="card__swatches" aria-hidden="true">{p.colors.slice(0, 4).map((c) => <i style={`background:${c.hex}`}></i>)}</span>
      <button class="btn" data-add={p.slug} aria-label={`Sumar ${p.name} a la bolsa`}><span>Sumar a la bolsa</span><Icon name="plus" size={16} /></button>
    </div>
  </div>
  <div class="card__info">
    <div>
      <h3 class="card__name"><a class="card__link" href={u(`/producto/${p.slug}`)}>{p.name}</a></h3>
      <p class="card__meta">{p.cat} · {p.hours} h de tejido</p>
    </div>
    <span class="card__price">{priceLabel(p)}</span>
  </div>
</article>

<style>
  /* el link cubre toda la tarjeta pero los botones quedan por encima */
  .card__link::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--r-card); }
  .card__link:focus-visible { outline: none; }
  .card__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .card__media:has(.card__photo) .tag { box-shadow: 0 4px 14px -6px rgb(46 26 19 / .35); }
  @media (hover: hover) and (pointer: fine) { .card:hover .card__photo { transform: scale(1.05); } }
  .card:has(.card__link:focus-visible) .card__media { outline: 3px solid var(--lilac-deep); outline-offset: 4px; }
</style>
